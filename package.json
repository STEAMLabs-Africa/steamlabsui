{
  "name": "@steamlabs/ui",
  "version": "0.1.0",
  "description": "STEAMLabs Africa UI library: design tokens, CSS and React components from the STEAMLabs web design system and Brand Manual.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./tokens": { "types": "./dist/tokens.d.ts", "import": "./dist/tokens.js", "require": "./dist/tokens.cjs" },
    "./logo": { "types": "./dist/logo.d.ts", "import": "./dist/logo.js", "require": "./dist/logo.cjs" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css",
    "./brand.css": "./dist/brand.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./logos/*": "./dist/logos/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && bun scripts/build-logos.ts && tsup && bun scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run build && bun test",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "restricted" }
}
